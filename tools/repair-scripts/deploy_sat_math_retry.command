#!/usr/bin/env bash
set -Eeuo pipefail
export AWS_PAGER=""

PROFILE="denduluru"
EXPECTED_ACCOUNT="989174615155"
REGION="us-east-1"
BUCKET="sat-prep-josh"
MATH_APP_KEY="math/app.js"
CLOUDFRONT_DISTRIBUTION_ID="E2WHKAAIHGKMVF"

for command in aws python3 node zip unzip curl; do
  command -v "$command" >/dev/null 2>&1 || {
    echo "ERROR: $command is required." >&2
    exit 1
  }
done

AWS=(aws --profile "$PROFILE" --region "$REGION")
ACCOUNT_ID="$("${AWS[@]}" sts get-caller-identity --query Account --output text)"
if [[ "$ACCOUNT_ID" != "$EXPECTED_ACCOUNT" ]]; then
  echo "ERROR: Profile $PROFILE is using AWS account $ACCOUNT_ID." >&2
  echo "Expected account: $EXPECTED_ACCOUNT" >&2
  exit 1
fi

echo "AWS account: $ACCOUNT_ID"
echo "Bucket:      $BUCKET"
echo "Math file:  $MATH_APP_KEY"

"${AWS[@]}" s3api head-object --bucket "$BUCKET" --key "$MATH_APP_KEY" >/dev/null

WORK_DIR="$(mktemp -d)"
ORIGINAL_APP="$WORK_DIR/app-original.js"
PATCHED_APP="$WORK_DIR/app-patched.js"
ORIGINAL_LAMBDA="$WORK_DIR/lambda-original.zip"
LAMBDA_DIR="$WORK_DIR/lambda"
UPDATED_LAMBDA="$WORK_DIR/lambda-updated.zip"
STAMP="$(date -u +%Y%m%dT%H%M%SZ)"
LAMBDA_UPDATED=0
APP_UPDATED=0
SUCCESS=0

rollback() {
  local status=$?
  if [[ "$SUCCESS" -eq 1 ]]; then
    rm -rf "$WORK_DIR"
    return
  fi
  set +e
  echo
  echo "Deployment failed. Restoring previous files..."
  if [[ "$APP_UPDATED" -eq 1 ]]; then
    "${AWS[@]}" s3 cp "$ORIGINAL_APP" "s3://$BUCKET/$MATH_APP_KEY" \
      --content-type "application/javascript; charset=utf-8" \
      --cache-control "no-cache, no-store, must-revalidate" \
      --only-show-errors
  fi
  if [[ "$LAMBDA_UPDATED" -eq 1 && -n "${LAMBDA_FUNCTION:-}" ]]; then
    "${AWS[@]}" lambda update-function-code \
      --function-name "$LAMBDA_FUNCTION" \
      --zip-file "fileb://$ORIGINAL_LAMBDA" >/dev/null
    "${AWS[@]}" lambda wait function-updated --function-name "$LAMBDA_FUNCTION"
  fi
  rm -rf "$WORK_DIR"
  echo "Previous version restored."
  exit "$status"
}
trap rollback EXIT

"${AWS[@]}" s3 cp "s3://$BUCKET/$MATH_APP_KEY" "$ORIGINAL_APP" --only-show-errors
cp "$ORIGINAL_APP" "$PATCHED_APP"

PROGRESS_API="$(python3 - "$ORIGINAL_APP" <<'PY_API'
from pathlib import Path
import re, sys
text = Path(sys.argv[1]).read_text(encoding='utf-8')
match = re.search(r"const\s+PROGRESS_API\s*=\s*['\"]([^'\"]+)['\"]", text)
if not match:
    match = re.search(r"https://[A-Za-z0-9-]+\.lambda-url\.[A-Za-z0-9-]+\.on\.aws/?", text)
if not match:
    raise SystemExit('ERROR: Could not find the live Lambda Function URL in math/app.js.')
url = match.group(1) if match.lastindex else match.group(0)
print(url.rstrip('/') + '/')
PY_API
)"
echo "Progress API: $PROGRESS_API"

echo "Finding the matching Lambda function..."
LAMBDA_FUNCTION=""
while IFS= read -r function_name; do
  [[ -z "$function_name" ]] && continue
  function_url="$("${AWS[@]}" lambda get-function-url-config \
    --function-name "$function_name" --query FunctionUrl --output text 2>/dev/null || true)"
  if [[ -n "$function_url" && "$function_url" != "None" ]]; then
    function_url="${function_url%/}/"
    if [[ "$function_url" == "$PROGRESS_API" ]]; then
      LAMBDA_FUNCTION="$function_name"
      break
    fi
  fi
done < <("${AWS[@]}" lambda list-functions --query 'Functions[].FunctionName' --output text | tr '\t' '\n')

if [[ -z "$LAMBDA_FUNCTION" ]]; then
  echo "ERROR: No Lambda Function URL matches $PROGRESS_API in account $ACCOUNT_ID." >&2
  exit 1
fi
echo "Lambda:      $LAMBDA_FUNCTION"

HANDLER_SETTING="$("${AWS[@]}" lambda get-function-configuration \
  --function-name "$LAMBDA_FUNCTION" --query Handler --output text)"
HANDLER_MODULE="${HANDLER_SETTING%%.*}"
CURRENT_CODE_URL="$("${AWS[@]}" lambda get-function \
  --function-name "$LAMBDA_FUNCTION" --query Code.Location --output text)"
curl -fsSL "$CURRENT_CODE_URL" -o "$ORIGINAL_LAMBDA"
mkdir -p "$LAMBDA_DIR"
unzip -q "$ORIGINAL_LAMBDA" -d "$LAMBDA_DIR"

HANDLER_FILE=""
for extension in mjs js cjs; do
  candidate="$LAMBDA_DIR/${HANDLER_MODULE}.${extension}"
  if [[ -f "$candidate" ]]; then
    HANDLER_FILE="$candidate"
    break
  fi
done
if [[ -z "$HANDLER_FILE" ]]; then
  echo "ERROR: Handler file for $HANDLER_SETTING was not found in the Lambda package." >&2
  exit 1
fi

echo "Patching the current live files..."
python3 - "$PATCHED_APP" "$HANDLER_FILE" <<'PY_PATCH'
import sys, re, base64
from pathlib import Path

APP_PATH = Path(sys.argv[1])
HANDLER_PATH = Path(sys.argv[2])

SNIPS = {'cloud': '', 'apply_saved': '', 'update_stats': '', 'app_helpers': '', 'handler_helpers': '', 'record': 'YXN5bmMgZnVuY3Rpb24gcmVjb3JkQXR0ZW1wdCh7IHVzZXJJZCwgcXVlc3Rpb25JZCwgY29ycmVjdCwgY2hvaWNlLCBjYXRlZ29yeSB9', 'normalize': '', 'getprogress': ''}
def snippet(name): return base64.b64decode(SNIPS[name]).decode('utf-8')

def function_span(text, name):
    match = re.search(r'(?:async\s+)?function\s+' + re.escape(name) + r'\s*\(', text)
    if not match:
        raise RuntimeError(f"Required JavaScript function not found: {name}")
    start = match.start()
    brace = text.find('{', match.end())
    if brace < 0:
        raise RuntimeError(f"Opening brace not found for: {name}")
    depth = 0
    state = 'normal'
    i = brace
    while i < len(text):
        char = text[i]
        nxt = text[i + 1] if i + 1 < len(text) else ''
        if state == 'normal':
            if char == "'": state = 'single'
            elif char == '"': state = 'double'
            elif char == '`': state = 'template'
            elif char == '/' and nxt == '/': state = 'line'; i += 1
            elif char == '/' and nxt == '*': state = 'block'; i += 1
            elif char == '{': depth += 1
            elif char == '}':
                depth -= 1
                if depth == 0: return start, i + 1
        elif state == 'single':
            if char == '\\': i += 1
            elif char == "'": state = 'normal'
        elif state == 'double':
            if char == '\\': i += 1
            elif char == '"': state = 'normal'
        elif state == 'template':
            if char == '\\': i += 1
            elif char == '`': state = 'normal'
        elif state == 'line':
            if char == '\n': state = 'normal'
        elif state == 'block':
            if char == '*' and nxt == '/': state = 'normal'; i += 1
        i += 1
    raise RuntimeError(f"Unclosed function: {name}")

def replace_function(text, name, replacement):
    start, end = function_span(text, name)
    return text[:start] + replacement + text[end:]

def add_get_command(text):
    pattern = re.compile(r"""import\s*\{(?P<body>.*?)\}\s*from\s*(['"])@aws-sdk/lib-dynamodb\2\s*;?""", re.S)
    match = pattern.search(text)
    if not match:
        raise RuntimeError('AWS DynamoDB document client import was not found in Lambda handler.')
    body = match.group('body')
    if re.search(r'\bGetCommand\b', body):
        return text
    indent = '  ' if '\n' in body else ' '
    stripped = body.rstrip()
    if stripped and not stripped.rstrip().endswith(','):
        stripped += ','
    addition = f"{stripped}\n{indent}GetCommand\n"
    return text[:match.start('body')] + addition + text[match.end('body'):]

def patch_app(text):
    if 'SAT_MILESTONE_RETRY_UI_V1' in text:
        print('Math app retry UI is already installed.')
        return text

    text = replace_function(text, 'cloudItemToLocal', snippet('cloud'))

    insert_marker = 'const SAT_FORMULA_GROUPS ='
    if insert_marker in text:
        text = text.replace(insert_marker, snippet('app_helpers') + '\n' + insert_marker, 1)
    else:
        marker = 'async function initVolumePage()'
        if marker not in text:
            raise RuntimeError('Could not locate an insertion point in math/app.js.')
        text = text.replace(marker, snippet('app_helpers') + '\n' + marker, 1)

    list_pattern = re.compile(r"""(?P<line>\s*const\s+list\s*=\s*document\.getElementById\(['"]question-list['"]\);)""")
    match = list_pattern.search(text)
    if not match:
        raise RuntimeError('Question list initialization was not found in math/app.js.')
    text = text[:match.end()] + '\n  let correctionUi = null;' + text[match.end():]

    needs_review = re.compile(r"""(?P<indent>\s*)if\s*\(state\.status\s*===\s*['"]Needs review['"]\s*&&\s*\(!progress\s*\|\|\s*progress\.correct\)\)\s*return false;""")
    match = needs_review.search(text)
    if not match:
        raise RuntimeError('Needs review filter was not found in math/app.js.')
    extra = "\n" + match.group('indent') + "if (state.status === 'Corrections available' && (!progress || progress.correct || progress.locked || !progress.correctionAllowed)) return false;"
    text = text[:match.end()] + extra + text[match.end():]

    text = replace_function(text, 'applySavedState', snippet('apply_saved'))

    old = ": 'This question is locked until the administrator allows another attempt.');"
    new = ": existing.attempts > 1\n          ? 'This correction attempt is complete. Ask the administrator to allow another attempt.'\n          : 'This question is locked until the next 20-question correction milestone.');"
    if old not in text:
        raise RuntimeError('Locked-question message was not found in math/app.js.')
    text = text.replace(old, new, 1)

    save_marker = "      delete state.selected[question.id];"
    if save_marker not in text:
        raise RuntimeError('Saved-answer marker was not found in math/app.js.')
    text = text.replace(save_marker, save_marker + '\n      await syncFromCloud();', 1)

    text = text.replace(
        "showFeedback(card, false, 'This question is locked until the administrator allows another attempt.');",
        "showFeedback(card, false, 'This question is locked until its correction milestone or administrator approval.');",
        1
    )

    text = replace_function(text, 'updateStats', snippet('update_stats'))

    search_marker = "  document.getElementById('search').oninput = event => {"
    if search_marker not in text:
        raise RuntimeError('Search control initialization was not found in math/app.js.')
    initializer = "  correctionUi = installCorrectionExperience({ questions, state, render, topicSelect, topicNav });\n\n"
    text = text.replace(search_marker, initializer + search_marker, 1)
    return text

def patch_handler(text):
    if 'SAT_MILESTONE_RETRY_V1' in text:
        print('Lambda retry policy is already installed.')
        return text

    text = add_get_command(text)
    marker = 'async function recordAttempt'
    if marker not in text:
        raise RuntimeError('recordAttempt was not found in Lambda handler.')
    text = text.replace(marker, snippet('handler_helpers') + marker, 1)
    text = replace_function(text, 'recordAttempt', snippet('record'))
    text = replace_function(text, 'normalizeProgressItem', snippet('normalize'))
    text = replace_function(text, 'getProgress', snippet('getprogress'))
    return text

app = APP_PATH.read_text(encoding='utf-8')
handler = HANDLER_PATH.read_text(encoding='utf-8')
app = patch_app(app)
handler = patch_handler(handler)
APP_PATH.write_text(app, encoding='utf-8')
HANDLER_PATH.write_text(handler, encoding='utf-8')
print('Live Math app and Lambda handler patched successfully.')

PY_PATCH

node --check "$PATCHED_APP"
node --check "$HANDLER_FILE"

echo "Backing up the current live files..."
"${AWS[@]}" s3 cp "s3://$BUCKET/$MATH_APP_KEY" \
  "s3://$BUCKET/backups/math-retry-$STAMP/$MATH_APP_KEY" --only-show-errors
"${AWS[@]}" s3 cp "$ORIGINAL_LAMBDA" \
  "s3://$BUCKET/backups/math-retry-$STAMP/lambda-original.zip" --only-show-errors

(
  cd "$LAMBDA_DIR"
  zip -qr "$UPDATED_LAMBDA" .
)

echo "Deploying Lambda..."
"${AWS[@]}" lambda update-function-code \
  --function-name "$LAMBDA_FUNCTION" \
  --zip-file "fileb://$UPDATED_LAMBDA" >/dev/null
LAMBDA_UPDATED=1
"${AWS[@]}" lambda wait function-updated --function-name "$LAMBDA_FUNCTION"

# Confirm that the updated API still answers before changing the website.
curl -fsS -X POST -H 'Content-Type: application/json' \
  --data '{"action":"progress","userId":"josh"}' "$PROGRESS_API" \
  | python3 -c 'import json,sys; data=json.load(sys.stdin); assert isinstance(data.get("items"), list); assert "retryPolicy" in data'

echo "Uploading Math app.js..."
"${AWS[@]}" s3 cp "$PATCHED_APP" "s3://$BUCKET/$MATH_APP_KEY" \
  --content-type "application/javascript; charset=utf-8" \
  --cache-control "no-cache, no-store, must-revalidate" \
  --only-show-errors
APP_UPDATED=1

"${AWS[@]}" s3 cp "s3://$BUCKET/$MATH_APP_KEY" "$WORK_DIR/app-verify.js" --only-show-errors
grep -q 'SAT_MILESTONE_RETRY_UI_V1' "$WORK_DIR/app-verify.js"

# CloudFront invalidation is useful but not allowed to fail the deployment.
"${AWS[@]}" cloudfront create-invalidation \
  --distribution-id "$CLOUDFRONT_DISTRIBUTION_ID" \
  --paths '/math/app.js*' >/dev/null 2>&1 || true

SUCCESS=1
echo
echo "DEPLOYMENT COMPLETE"
echo "Correction unlock milestones: 20, 40, 60, 80, and 100 unique first attempts."
echo "Question order does not matter."
echo "Question navigator is closed by default."
echo "Backup: s3://$BUCKET/backups/math-retry-$STAMP/"
